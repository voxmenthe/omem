{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "OMEM_HOST": "claude"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "memory hook claude",
            "timeout": 3,
            "statusMessage": "Loading memory turn context"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "memory hook claude",
            "timeout": 3,
            "statusMessage": "Loading memory recovery checkpoint"
          }
        ]
      }
    ]
  }
}
